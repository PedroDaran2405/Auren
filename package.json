{
  "name": "auren",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "packages/api-client"
  ],
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "start": "npm run start --workspace @auren/mobile",
    "web": "npm run web --workspace @auren/mobile",
    "typecheck": "tsc --noEmit -p apps/mobile/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "build:web": "npm run export:web --workspace @auren/mobile && node scripts/package-web.mjs",
    "build:native-js": "npm run export:native --workspace @auren/mobile",
    "audit:site": "node --use-env-proxy scripts/audit-site.mjs",
    "local:up": "bash scripts/local-up.sh",
    "local:down": "docker compose -f compose.test.yml down",
    "test:wordpress": "bash scripts/test-wordpress.sh",
    "package:plugin": "python3 scripts/package-plugin.py",
    "test:gamification": "docker compose -f compose.test.yml exec -T wp php /opt/auren-tests/gamification.php",
    "local:gamipress": "python3 scripts/local-gamipress.py",
    "test:header": "bash scripts/test-header.sh",
    "test:startup": "docker compose -f compose.test.yml exec -T wp php /opt/auren-tests/startup.php"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "~5.9.2",
    "@types/node": "^24.0.0"
  }
}
