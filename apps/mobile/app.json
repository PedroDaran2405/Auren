{
  "expo": {
    "name": "Auren",
    "slug": "auren-fx",
    "owner": "auren-fx",
    "version": "0.5.0",
    "icon": "./assets/icon.png",
    "scheme": "auren",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.aurenfx.academy",
      "supportsTablet": true
    },
    "android": {
      "package": "com.aurenfx.academy",
      "versionCode": 1
    },
    "extra": {
      "eas": {
        "projectId": "b13fe800-5cec-4287-b75a-6565639979ec"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/b13fe800-5cec-4287-b75a-6565639979ec",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Auren"
    },
    "experiments": {
      "baseUrl": "/wp-content/plugins/auren-app-bridge/web"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ]
  }
}
