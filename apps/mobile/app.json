{
  "expo": {
    "name": "Auren",
    "slug": "auren",
    "version": "0.3.0",
    "icon": "./assets/icon.png",
    "scheme": "auren",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.aurenfx.academy",
      "supportsTablet": true
    },
    "android": {
      "package": "com.aurenfx.academy"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Auren"
    },
    "experiments": {
      "baseUrl": "/wp-content/plugins/auren-app-bridge/web"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ]
  }
}
